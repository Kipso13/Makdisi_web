# GEMINI_API_KEY: Required for server-side Gemini AI assistant (/api/assistant/report-chat).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the app is hosted.
APP_URL="MY_APP_URL"

# Optional: Point a static GitHub Pages build to a hosted backend AI chat endpoint.
# VITE_CHAT_API_URL="https://your-backend.onrender.com/api/assistant/report-chat"

# Optional: Webhook URL (e.g., Formspree or Google Apps Script) to receive submissions when hosted statically on GitHub Pages.
# VITE_SUBMISSION_WEBHOOK_URL="https://formspree.io/f/your_form_id"
