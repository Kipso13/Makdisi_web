# GEMINI_API_KEY: Required for the server-side AI Problems & Suggestions assistant.
# Configured automatically in AI Studio Secrets or your local .env file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

